import ClaudeCrypto.X86.SHA256.Scalar

/-! Writes the generated assembly files.  Usage: `lake exe emit <outdir>` -/

def files : List (String × String) := [
  ("x86_64/sha256_scalar.S", CC.X86.SHA256Scalar.asm)
]

def header : String :=
  "/* Generated by claude-crypto/lean (lake exe emit). DO NOT EDIT.\n" ++
  " * This code is formally verified in Lean; see claude-crypto/README.md. */\n"

def main (args : List String) : IO Unit := do
  let out := args.headD "../asm"
  for (path, text) in files do
    let full := out ++ "/" ++ path
    if let some dir := (System.FilePath.mk full).parent then IO.FS.createDirAll dir
    IO.FS.writeFile full (header ++ text ++ "\t.section .note.GNU-stack,\"\",@progbits\n")
    IO.println s!"wrote {full}"
