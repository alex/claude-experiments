import ClaudeCrypto.X86.SHA256.Scalar
import ClaudeCrypto.X86.SHA256.Avx2
import ClaudeCrypto.X86.SHA256.ShaNi
import ClaudeCrypto.Arm.SHA256.Ce
import ClaudeCrypto.Ppc.SHA256.P8
import ClaudeCrypto.X86.P384Wrap
import ClaudeCrypto.Arm.P384Wrap
import ClaudeCrypto.Ppc.P384Wrap

/-! Writes the generated assembly files.  Usage: `lake exe emit <outdir>` -/

def files : List (String × String) := [
  ("x86_64/sha256_scalar.S", CC.X86.SHA256Scalar.asm),
  ("x86_64/sha256_avx2.S", CC.X86.SHA256Avx2.asm ++ CC.dataSection CC.X86.SHA256Avx2.dataTables),
  ("x86_64/sha256_shani.S", CC.X86.SHA256ShaNi.asm ++ CC.dataSection CC.X86.SHA256ShaNi.dataTables),
  ("aarch64/sha256.S", CC.Arm.SHA256Ce.asm),
  ("ppc64le/sha256.S", CC.Ppc.SHA256P8.asm),
  ("x86_64/p384_verify.S", CC.X86.P384Wrap.asm),
  ("aarch64/p384_verify.S", CC.Arm.P384Wrap.asm),
  ("ppc64le/p384_verify.S", CC.Ppc.P384Wrap.asm)
]

def header : String :=
  "/* Generated by claude-crypto/lean (lake exe emit). DO NOT EDIT.\n" ++
  " * This code is formally verified in Lean; see claude-crypto/README.md. */\n"

def main (args : List String) : IO Unit := do
  let out := args.headD "../asm"
  for (path, text) in files do
    let full := out ++ "/" ++ path
    if let some dir := (System.FilePath.mk full).parent then IO.FS.createDirAll dir
    IO.FS.writeFile full (header ++ text ++ "\t.section .note.GNU-stack,\"\",@progbits\n")
    IO.println s!"wrote {full}"
